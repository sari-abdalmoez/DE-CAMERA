<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.raw" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <application android:theme="@style/Theme.SARICamera" android:label="SARI Camera" android:allowBackup="false" android:supportsRtl="true" android:resizeableActivity="true">
        <activity android:name=".MainActivity" android:screenOrientation="portrait" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
