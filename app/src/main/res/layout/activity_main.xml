<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sari_black">

    <TextureView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:layout_gravity="top"
        android:background="@drawable/top_fade" />

    <!-- S26/One UI inspired top controls: preview remains edge-to-edge, controls are inset below the status bar. -->
    <LinearLayout
        android:id="@+id/topControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/flashButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/icon_circle_bg"
            android:contentDescription="Flash"
            android:padding="10dp"
            android:src="@drawable/ic_flash_auto" />

        <TextView
            android:id="@+id/statusPill"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="PHOTO"
            android:textColor="@color/sari_white"
            android:textSize="12sp"
            android:background="@drawable/pill_bg" />

        <ImageButton
            android:id="@+id/settings"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/icon_circle_bg"
            android:contentDescription="Settings"
            android:padding="10dp"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <TextView
        android:id="@+id/capabilityText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="92dp"
        android:textColor="#CCFFFFFF"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/thermalText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="112dp"
        android:text="AI • STARTING"
        android:textColor="@color/sari_gold"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/processingText"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="146dp"
        android:background="@drawable/pill_bg"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="Processing • 0%"
        android:textColor="@color/sari_white"
        android:textSize="11sp"
        android:visibility="gone" />

    <View
        android:id="@+id/focusView"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/focus_ring"
        android:visibility="gone" />

    <!-- S26-like quick zoom row. -->
    <HorizontalScrollView
        android:id="@+id/zoomContainer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="178dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/zoomBar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Camera mode rail: MORE / PHOTO / VIDEO, like current Samsung Camera. -->
    <HorizontalScrollView
        android:id="@+id/modeContainer"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="112dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/modeBar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bottom_fade" />

    <!-- Extra modes opened from MORE. -->
    <LinearLayout
        android:id="@+id/morePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="158dp"
        android:background="@drawable/pill_bg"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/moreRow1"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/moreRow2"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- Bottom controls are kept above the navigation bar using WindowInsets in MainActivity. -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageButton
            android:id="@+id/gallery"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/icon_circle_bg"
            android:contentDescription="Gallery"
            android:maxWidth="52dp"
            android:padding="12dp"
            android:src="@drawable/ic_gallery" />

        <ImageButton
            android:id="@+id/shutter"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/shutter_button"
            android:contentDescription="Capture" />

        <ImageButton
            android:id="@+id/switchCamera"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/icon_circle_bg"
            android:contentDescription="Switch camera"
            android:maxWidth="52dp"
            android:padding="12dp"
            android:src="@drawable/ic_flip_camera" />
    </LinearLayout>
</FrameLayout>
